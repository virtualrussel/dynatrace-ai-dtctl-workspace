{
  "servers": {
    "dynatrace-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dynatrace-oss/dynatrace-mcp-server@latest",
        "--stdio"
      ],
      "env": {
        "DT_ENVIRONMENT": "https://YOUR_TENANT_ID.apps.dynatrace.com"
      }
    }
  }
}
